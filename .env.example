# Copy to .env and adjust as needed: `cp .env.example .env`
# These values are consumed by docker-compose.yml.

# --- PostgreSQL (single instance, one database per service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- API gateway CORS (comma-separated origins allowed to call the API) ---
# 8090 is the dockerized frontend; 5173 is the local Vite dev server.
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8090

# --- Frontend build-time API base URL (baked into the bundle) ---
# The browser talks to the gateway via its host-published port.
VITE_API_BASE_URL=http://localhost:8080/api/v1
